# Copy to .env. Requires Node.js 20.12+; CLI flags override these values.
# Existing shell environment variables take precedence over this file.
TELEGRAM_SCAN_FOLDER="小姐"
TELEGRAM_SCAN_LIMIT=0
TELEGRAM_SCAN_SINCE=
TELEGRAM_SCAN_OUTPUT=weight-scan
TELEGRAM_SCAN_EXPORT_FILE=folder-content.json
TELEGRAM_SCAN_DRY_RUN=false
TELEGRAM_SCAN_IMAGE_MAX_MIB=15
TELEGRAM_SCAN_ALBUM_MAX_MIB=40
TELEGRAM_SCAN_DOWNLOAD_TIMEOUT_MS=60000

# Optional full-history message counts. Empty defaults to <scan output>/message-stats.json.
TELEGRAM_MESSAGE_STATS_OUTPUT=

# Optional offline Markdown conversion paths. Empty values follow scan output.
TELEGRAM_MARKDOWN_INPUT=
TELEGRAM_MARKDOWN_OUTPUT=
# Relative to the Markdown output directory; empty uses <Markdown filename>.assets.
TELEGRAM_MARKDOWN_ASSETS_DIR=
# Inline thumbnail width in pixels. Click a thumbnail to open the full image.
TELEGRAM_MARKDOWN_IMAGE_WIDTH=120

# Reserved for a later, explicitly requested analysis stage; ignored by scan.
TELEGRAM_SCAN_BELOW_JIN=95
TELEGRAM_SCAN_REQUEST_TIMEOUT_MS=120000

# Existing shared configuration and export paths (optional)
# TELEGRAM_FOLDER_RULES=folder_rules.json
# TELEGRAM_DIALOG_SNAPSHOT=dialogs_snapshot.json
# TELEGRAM_CLASSIFIED_OUTPUT=classified_dialogs.json
# TELEGRAM_UNFILED_OUTPUT=unfiled_dialogs.json
# TELEGRAM_FOLDER_STATS_OUTPUT=folder_stats.json
# TELEGRAM_FOLDER_OVERLAPS_OUTPUT=folder_overlaps.json
